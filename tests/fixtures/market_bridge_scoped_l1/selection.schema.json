{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "twichui-market-selection"
    },
    "contract_version": {
      "const": 1
    },
    "expected_schema_version": {
      "const": 3
    },
    "issuer_id": {
      "$ref": "https://twichui.example/contracts/bridge/v1/generation-schema2.json#/properties/issuer_id"
    },
    "market": {
      "$ref": "https://twichui.example/contracts/bridge/v1/generation-schema2.json#/properties/market"
    },
    "scope_type": {
      "const": "explicit_variants"
    },
    "variants": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "item_id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "variant_key": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "item_id",
          "variant_key"
        ]
      }
    },
    "history_from_day": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "history_through_day": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "pricing_algorithm": {
      "$ref": "https://twichui.example/contracts/bridge/v1/generation-schema2.json#/properties/pricing_algorithm"
    },
    "history_basis": {
      "$ref": "https://twichui.example/contracts/bridge/v1/generation-schema2.json#/properties/history_basis"
    },
    "profile": {
      "const": "daily_research_v1"
    }
  },
  "required": [
    "format",
    "contract_version",
    "expected_schema_version",
    "issuer_id",
    "market",
    "scope_type",
    "variants",
    "history_from_day",
    "history_through_day",
    "pricing_algorithm",
    "history_basis",
    "profile"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://twichui.example/contracts/bridge/scoped-l1/selection.json",
  "allOf": [
    {
      "if": {
        "properties": {
          "pricing_algorithm": {
            "const": "twichui-pricing-v1"
          }
        }
      },
      "then": {
        "properties": {
          "history_basis": {
            "const": "canonical_complete_scope_close"
          }
        }
      },
      "else": {
        "properties": {
          "history_basis": {
            "const": "market_rolling_daily_means"
          }
        }
      }
    }
  ]
}

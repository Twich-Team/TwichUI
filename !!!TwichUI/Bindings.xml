<Bindings>
	<!-- TwichUI's key bindings (Options > Key Bindings > TwichUI). Their names are set in
	     modules/RefreshmentsPanel.lua. The conjure keys click the refreshments panel's own secure buttons,
	     once per press; with Mage refreshments off, or on another class, they do nothing. -->
	<Binding name="TWICHUI_REFRESHMENTS" category="BINDING_HEADER_TWICHUI">
		TwichUI.Refreshments.TogglePanel()
	</Binding>
	<Binding name="CLICK TwichUIRefreshmentsWater:LeftButton" category="BINDING_HEADER_TWICHUI"/>
	<Binding name="CLICK TwichUIRefreshmentsFood:LeftButton" category="BINDING_HEADER_TWICHUI"/>
	<!-- Easy Fishing (qol/EasyFishing.lua): casts Fishing, and while a line is out the file puts the game's
	     interact action on the same key. No default key; with the feature off the button does nothing. -->
	<Binding name="CLICK TwichUIEasyFishingCast:LeftButton" category="BINDING_HEADER_TWICHUI"/>
</Bindings>

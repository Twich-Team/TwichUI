<Bindings>
	<!-- TwichUI's key bindings (Options > Key Bindings > TwichUI). Their names are set in
	     modules/RefreshmentsPanel.lua. The conjure keys click the refreshments panel's own secure buttons,
	     once per press; with Mage refreshments off, or on another class, they do nothing. -->
	<Binding name="TWICHUI_REFRESHMENTS" category="BINDING_HEADER_TWICHUI">
		TwichUI.Refreshments.TogglePanel()
	</Binding>
	<Binding name="CLICK TwichUIRefreshmentsWater:LeftButton" category="BINDING_HEADER_TWICHUI"/>
	<Binding name="CLICK TwichUIRefreshmentsFood:LeftButton" category="BINDING_HEADER_TWICHUI"/>
	<!-- Marker cycling (markers/Keys.lua names them). Each clicks one of TwichUI's own secure buttons once per
	     press; with its kind of marker cycling off they do nothing. No key is bound until you choose one. -->
	<Binding name="CLICK TwichUIMarkTargetNext:LeftButton" category="BINDING_HEADER_TWICHUI"/>
	<Binding name="CLICK TwichUIMarkTargetRestart:LeftButton" category="BINDING_HEADER_TWICHUI"/>
	<Binding name="CLICK TwichUIMarkTargetClear:LeftButton" category="BINDING_HEADER_TWICHUI"/>
	<Binding name="CLICK TwichUIMarkWorldNext:LeftButton" category="BINDING_HEADER_TWICHUI"/>
	<Binding name="CLICK TwichUIMarkWorldRestart:LeftButton" category="BINDING_HEADER_TWICHUI"/>
	<Binding name="CLICK TwichUIMarkWorldClear:LeftButton" category="BINDING_HEADER_TWICHUI"/>
	<!-- Camping bar (camping/Bar.lua names it): clicks the bar's eat button, which eats the buff food and sits down. Does
	     nothing while the eat button is off. No key is bound until you choose one. -->
	<Binding name="CLICK TwichUICampingEat:LeftButton" category="BINDING_HEADER_TWICHUI"/>
	<!-- TwichUI Fishing (FishingLauncher.lua names them; TwichUI_Fishing/Action.lua makes the buttons when it loads, which a
	     bound key makes happen at login). Each press is one step: equip the pole, apply a lure, open a clam or cast; while the
	     line is out the same key reels in. No key is bound until you choose one. -->
	<Binding name="CLICK TwichUIFishingButton:LeftButton" category="BINDING_HEADER_TWICHUI"/>
	<Binding name="CLICK TwichUIFishingOpen:LeftButton" category="BINDING_HEADER_TWICHUI"/>
	<!-- Fishing Mode (TwichUI_Fishing/Present.lua): on or off, and the faded interface shown while the key is held. Neither
	     casts, reels or acts in the game; they only change what is on screen and the camera. -->
	<Binding name="TWICHUI_FISHING_MODE" category="BINDING_HEADER_TWICHUI">
		TwichUI.FishingLauncher.Mode()
	</Binding>
	<Binding name="TWICHUI_FISHING_REVEAL" category="BINDING_HEADER_TWICHUI" runOnUp="true">
		TwichUI.FishingLauncher.Reveal(keystate)
	</Binding>
	<!-- Invite nearby players (qol/NearbyInvite.lua names it): each press invites the friendly players close to you
	     to your group. No key is bound until you choose one. -->
	<Binding name="TWICHUI_INVITE_NEARBY" category="BINDING_HEADER_TWICHUI">
		TwichUI.QoLNearbyInvite.Invite()
	</Binding>
</Bindings>

qol\TwichUISettingsButton.lua

# Marker cycling: a key that marks your target with the next target marker, and one that places the next world
# marker at the mouse pointer, in an order you choose; each with a restart key and a clear key (off until turned on;
# no key is bound until you choose one; key bindings in Bindings.xml). Markers.lua is the order, Keys.lua the
# game's secure buttons the keys press.
markers\Markers.lua
markers\Keys.lua

# Marker bar: hold a modifier key and a bar of target markers appears for your target (above its nameplate, or at a
# place you choose); click one to mark it. Off until turned on. Bar.lua; its look uses modules\MenuStyle.lua.
markers\Bar.lua


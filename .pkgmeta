package-as: "!!!TwichUI"

# The repository holds seven addons side by side: !!!TwichUI/ (the core addon), TwichUI_Settings/ (the settings
# window, load on demand), TwichUI_NavData/ (navigation's walking maps, load on demand), TwichUI_Diagnostics/ (the
# profiling and support tool, load on demand), TwichUI_Layouts/ (layout packages, load on demand) and
# TwichUI_LayoutWizard/ (the layout setup, load on demand, needs TwichUI_Layouts) and TwichUI_Workshop/ (recipes, a craft queue and
# the materials still needed, load on demand). The packager
# builds the whole repository as the package folder, so all land one level down: the core addon is moved up over the
# package folder (repository-level files such as README.md, LICENSE and licenses/ stay in it, as they always have), and
# the other six are moved out beside it. The release zip holds exactly seven folders, !!!TwichUI, TwichUI_Settings,
# TwichUI_NavData, TwichUI_Diagnostics, TwichUI_Layouts, TwichUI_LayoutWizard and TwichUI_Workshop. Keep the !!! folder name: TwichUI must load first,
# and the game names saved variables files after the folder.
# (The packager keeps the quotes of a key as part of it, so these keys are not quoted; values may be.)
move-folders:
  !!!TwichUI/!!!TwichUI: "!!!TwichUI"
  !!!TwichUI/TwichUI_Settings: TwichUI_Settings
  !!!TwichUI/TwichUI_NavData: TwichUI_NavData
  !!!TwichUI/TwichUI_Diagnostics: TwichUI_Diagnostics
  !!!TwichUI/TwichUI_Layouts: TwichUI_Layouts
  !!!TwichUI/TwichUI_LayoutWizard: TwichUI_LayoutWizard
  !!!TwichUI/TwichUI_Workshop: TwichUI_Workshop

enable-nolib-creation: no

manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown

ignore:
  - tests
  - tools
  - .github
  - RELEASING.md
  - CLAUDE.md
  - AGENTS.md
  - assets
  - test-output
  - .gitignore
  - docs
  - .clinerules
  - KNOWN_BUGS.md
  # the in-game Test Lab is a development tool and must never be in a release (docs/testlab.md)
  - TwichUI_TestLab
  # a development session note (it quotes local machine paths); not part of the addon
  - TwichUI-Workbench-Session-Handoff-2026-11-03.md
  # an editor workspace file kept at pins/ (not the addon's pins/ folder): it must not collide with !!!TwichUI/pins
  - pins/TwichUI.code-workspace

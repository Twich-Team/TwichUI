# The page list and the controls pages describe themselves with (no frames)
Kit.lua

# One file per page, in any order (each page says its place)
pages\Overview.lua
pages\Gear.lua
pages\Notifications.lua
pages\QoL.lua
pages\FoodDrink.lua
pages\Mage.lua
pages\Chronicle.lua
pages\Pins.lua
pages\Auction.lua
pages\Skins.lua
pages\RestedXP.lua
pages\SpeakStone.lua
pages\Sharing.lua
pages\Profiles.lua
pages\Troubleshooting.lua

# Search over the pages' descriptions, the controls the window draws with, and the window (last: it tells
